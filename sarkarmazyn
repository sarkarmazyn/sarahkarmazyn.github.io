<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sarah Karmazyn</title>
<meta name="description" content="Sarah Karmazyn — product manager building products where regulated finance meets crypto markets, with deep domain expertise in risk and derivatives. Coinbase Financial Markets, Coinbase International Exchange.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  /* Rustic Elegance: ochre #8B5B29 · wine #6F2C3E · sand #D9CBAE · sienna #A0522D · chocolate #4B2C20 */
  --bg:#170910;
  --surface:#3A1929;
  --surface-2:#4A2234;
  --ink:#F3EADB;
  --muted:#D9CBAE;
  --faint:#B39C7F;
  --line:#7A3750;
  --line-2:#995067;
  --accent:#EFE5D2;
  --accent-2:#6F2C3E;
  --accent-ink:#F7F0E2;
  --accent-bg:rgba(239,229,210,.13);
  --sienna:#A0522D;
  --ochre:#8B5B29;
  --wine:#6F2C3E;
  --sand:#D9CBAE;
  --choc:#4B2C20;
  --glow:0 0 0 1px rgba(239,229,210,.14), 0 8px 30px rgba(8,2,5,.55);
  --ok:#EFE5D2;
  --sans:"Google Sans","Google Sans Text","DM Sans","Helvetica Neue",Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
  font-size:1.0625rem;line-height:1.6;-webkit-font-smoothing:antialiased;position:relative}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(52rem 30rem at 82% -8%, rgba(239,229,210,.17), transparent 68%),
    radial-gradient(40rem 26rem at 6% 6%, rgba(111,44,62,.30), transparent 70%),
    radial-gradient(60rem 40rem at 50% 108%, rgba(111,44,62,.26), transparent 72%);}
body::after{content:"";position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.5;
  background-image:
    linear-gradient(rgba(239,229,210,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(239,229,210,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(70rem 50rem at 60% 0%, #000 30%, transparent 78%);
  mask-image:radial-gradient(70rem 50rem at 60% 0%, #000 30%, transparent 78%)}
.wrap{position:relative;z-index:2}
a{color:inherit;text-decoration:none}
p a{color:var(--accent-ink);border-bottom:1px solid var(--accent-bg);padding-bottom:1px;font-weight:500}
p a:hover{border-color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3{letter-spacing:-.025em;font-weight:600;margin:0}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
.wrap{max-width:72rem;margin:0 auto;padding:0 2rem}
.eyebrow{font-size:.875rem;font-weight:600;color:var(--faint);margin:0 0 1.25rem}

/* top */
.top{display:flex;align-items:center;justify-content:flex-end;gap:1rem;padding:1.75rem 0 0}
.socials{display:flex;gap:.4rem}
.toplogos{display:flex;align-items:center;gap:.7rem}
.toplogos img{width:2.4rem;height:2.4rem;border-radius:50%;object-fit:contain;display:block;opacity:.9;transition:opacity .18s}
.toplogos img:hover{opacity:1}
@media(max-width:560px){.toplogos img{width:1.9rem;height:1.9rem}.toplogos{gap:.5rem}}
.soc{width:2.2rem;height:2.2rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);
  display:grid;place-items:center;font-size:.75rem;color:var(--muted);transition:.18s cubic-bezier(.2,.7,.3,1);box-shadow:0 1px 2px rgba(16,8,6,.45)}
.soc:hover{color:var(--accent);border-color:var(--accent);transform:translateY(-1px)}

/* hero */
.hero{display:grid;grid-template-columns:minmax(0,1fr) 15rem;gap:3.5rem;align-items:center;padding:3rem 0 2.25rem}
.status{display:inline-flex;align-items:center;gap:.5rem;border:1px solid var(--line);background:var(--surface);
  border-radius:99px;padding:.35rem .85rem .35rem .7rem;font-size:.8125rem;color:var(--muted);margin-bottom:1.75rem}
.blip{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 rgba(239,229,210,.5);animation:blip 2.8s infinite}
@keyframes blip{70%{box-shadow:0 0 0 8px rgba(239,229,210,0)}100%{box-shadow:0 0 0 0 rgba(239,229,210,0)}}
.hero h1{font-size:clamp(2.15rem,4.9vw,3.25rem);line-height:1.07;letter-spacing:-.036em;max-width:19ch}
.hero .lead{margin:1.5rem 0 0;font-size:1.0625rem;color:var(--muted);max-width:none}
.portrait{position:relative;justify-self:end}
.pname{position:relative;z-index:2;margin:1.15rem 0 0;font-size:1.0625rem;font-weight:600;letter-spacing:-.01em;color:var(--ink);text-align:center;width:15rem}
.portrait img{position:relative;z-index:2;width:15rem;height:15rem;object-fit:cover;border-radius:18px;
  display:block;box-shadow:0 1px 2px rgba(16,8,6,.5),0 18px 38px -18px rgba(16,8,6,.7)}
.portrait .frame{position:absolute;inset:0;transform:translate(10px,10px);border:1.5px solid var(--accent);
  border-radius:18px;z-index:1;opacity:.35}
@media(max-width:900px){.hero{grid-template-columns:1fr;gap:1.5rem;padding:1.75rem 0 1.5rem}.hero>div:first-child{order:2}.portrait{order:1;justify-self:start}.portrait img{width:5.5rem;height:5.5rem;border-radius:14px}.portrait .frame{transform:translate(6px,6px);border-radius:14px;width:5.5rem;height:5.5rem}.pname{width:auto;white-space:nowrap;text-align:left;font-size:.9375rem;margin-top:.7rem}}

/* about */
.about{padding:0 0 1.75rem}
.about p{margin:0 0 1.25rem;color:var(--muted);font-size:1.1875rem;line-height:1.68;max-width:68ch}
@media(max-width:640px){.about p{font-size:1.0625rem;line-height:1.62}}
.about p:last-of-type{margin-bottom:0}
.more{margin-top:0;display:inline-flex;align-items:center;gap:.45rem;font-size:.9375rem;font-weight:500;
  color:var(--muted);background:none;border:0;padding:0;cursor:pointer;font-family:inherit}
.more:hover{color:var(--accent)}
.more i{font-style:normal;transition:transform .25s}
.more[aria-expanded="true"] i{transform:rotate(90deg)}
.extra{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s cubic-bezier(.2,.7,.3,1)}
.more[aria-expanded="true"] + .extra{grid-template-rows:1fr}
.extra>div{overflow:hidden}
.extra p{padding-top:1.1rem}

/* section */
.sec{padding:2.25rem 0}
.sec-top{display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-bottom:1.15rem}
.sec-top h2{font-size:1.375rem;display:flex;align-items:center;gap:.6rem;white-space:nowrap}
.sub-top{display:flex;align-items:center;gap:.75rem;margin:2.25rem 0 1rem}
.sub-lbl{font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);white-space:nowrap}
.sec-top h2::before{content:"";width:7px;height:7px;border-radius:2px;background:var(--accent);flex:none}
.sec-top .rule{flex:1;height:1px;background:var(--line);min-width:1.5rem}
.sec-top .tabs{margin-left:auto}
@media(max-width:560px){.sec-top{gap:.75rem}.sec-top .rule{display:none}.sec-top .tabs{margin-left:0;width:100%}.sec-top .tab{flex:1}}

/* tabs */
.tabs{display:flex;gap:.25rem;background:var(--surface-2);border:1px solid var(--line);border-radius:11px;padding:.28rem}
.tab{border:0;background:none;font-family:inherit;font-size:.875rem;font-weight:500;color:var(--muted);
  padding:.4rem .8rem;border-radius:7px;cursor:pointer;transition:.15s;white-space:nowrap}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{background:var(--accent);color:#4A1526}

/* card */
.deck{position:relative}
.slide{display:none;grid-template-columns:15rem minmax(0,1fr);gap:0;background:var(--surface);
  border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(16,8,6,.45),0 12px 32px -12px rgba(16,8,6,.55)}
.slide.on{display:grid;animation:fade .35s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.slide-fig{position:relative;border-right:1px solid var(--line);display:grid;place-items:center;padding:2.5rem 1.25rem;min-height:15rem;
  background:linear-gradient(155deg,rgba(239,229,210,.14) 0%,rgba(111,44,62,.09) 100%);overflow:hidden}
.slide-fig::before{content:"";position:absolute;inset:0;opacity:.6;
  background-image:radial-gradient(circle at 1px 1px, rgba(239,229,210,.22) 1px, transparent 0);background-size:14px 14px}
.slide-fig b{position:relative}
.slide-fig b{font-family:var(--mono);font-size:2.9rem;font-weight:500;letter-spacing:-.05em;color:var(--accent-ink);line-height:1;text-align:center}
.slide-body{padding:1.6rem 1.75rem 1.75rem}
.meta{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem}
.pill{font-family:var(--mono);font-size:.6875rem;color:var(--muted);border:1px solid var(--line);
  border-radius:6px;padding:.2rem .5rem;background:#FAFAF8}
.pill.hot{color:#4A1526;background:var(--accent);border-color:var(--accent)}
.slide-body h3{font-size:1.3125rem;line-height:1.25;margin-bottom:.6rem}
.slide-body p{margin:0;color:var(--muted);font-size:.9688rem}
.slide-body p.mine{margin-top:.75rem;color:var(--faint);font-size:.9375rem}
.go{display:inline-flex;align-items:center;gap:.4rem;margin-top:1.1rem;font-size:.875rem;font-weight:500;color:var(--accent)}
.go:hover{text-decoration:underline;text-underline-offset:3px}
.deck-nav{display:flex;align-items:center;justify-content:space-between;margin-top:1rem}
.dots{display:flex;gap:.4rem}
.dot{width:6px;height:6px;border-radius:50%;background:var(--line);border:0;padding:0;cursor:pointer;transition:.2s}
.dot.on{background:var(--accent);width:18px;border-radius:99px}
.arrows{display:flex;gap:.4rem}
.arw{width:2.1rem;height:2.1rem;border:1px solid var(--line);border-radius:8px;background:var(--surface);
  color:var(--muted);cursor:pointer;font-family:var(--mono);font-size:.85rem;transition:.15s}
.arw:hover{color:var(--accent);border-color:var(--accent)}
@media(max-width:720px){
  .slide{grid-template-columns:1fr}
  .slide-fig{border-right:0;border-bottom:1px solid var(--line);min-height:0;padding:1.75rem}
  .slide-fig b{font-size:2.35rem}
  .slide-body{padding:1.35rem}
}

/* map / travel */
.travel-lead{margin:0 0 2rem;color:var(--muted)}
.travel-lead.wide{max-width:none}
.map-intro{margin-top:3rem}
.mapwrap{max-width:46rem;margin-left:auto;margin-right:auto;position:relative;background:var(--surface);border:1px solid var(--line);border-radius:18px;
  padding:.85rem;box-shadow:inset 0 1px 3px rgba(16,8,6,.5);overflow:hidden}
.mapwrap svg{display:block;width:100%;height:auto;border-radius:12px}
.map-grid line{stroke:var(--line-2);stroke-width:.5;opacity:.55}
.land{fill:#E7DCC6;stroke:#CBBBA0;stroke-width:.8;stroke-linejoin:round}
.pin{fill:var(--accent);opacity:.85;transition:r .15s ease,opacity .15s;cursor:default}
.pin:hover{r:6;opacity:1}
@keyframes ping{0%{r:2;opacity:0}45%{opacity:.9}100%{r:3.4;opacity:.9}}
.pin{animation:ping .6s ease both}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-top:.85rem}
.stat-box{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:1.15rem 1.25rem;
  box-shadow:0 1px 2px rgba(16,8,6,.45);text-align:center}
.stat-box b{display:block;font-family:var(--mono);font-size:1.85rem;font-weight:500;letter-spacing:-.04em;color:var(--accent-ink);line-height:1}
.stat-box span{display:block;font-size:.8125rem;color:var(--muted);margin-top:.4rem}
.regions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}
.rchip{font-family:var(--mono);font-size:.75rem;color:var(--muted);background:var(--surface);
  border:1px solid var(--line);border-radius:99px;padding:.35rem .8rem}
.rchip b{color:var(--accent);font-weight:500}
@media(max-width:700px){.stats-row{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){.pin{animation:none}}

/* abroad */
.abroad{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.city{background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;
  box-shadow:0 1px 2px rgba(16,8,6,.45);transition:transform .2s cubic-bezier(.2,.7,.3,1),box-shadow .2s,border-color .2s}
.city:hover{transform:translateY(-3px);border-color:var(--accent-bg);box-shadow:0 1px 2px rgba(16,8,6,.45),0 16px 32px -16px rgba(16,8,6,.65)}
.city svg{display:block;width:100%;height:auto;border-bottom:1px solid var(--line)}
.city-body{padding:.95rem 1.1rem 1.1rem;background:linear-gradient(180deg,#6A3352,#5A2C44);border-top:1px solid rgba(232,196,140,.22)}
.city-body .uni{color:var(--accent-ink)}
.city-top{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;flex-wrap:wrap}
.ptag{display:inline-block;font-family:var(--mono);font-size:.625rem;letter-spacing:.03em;padding:.2rem .55rem;border-radius:99px;white-space:nowrap}
.ptag.home{background:var(--accent);color:#4A1526}
.ptag.born{background:var(--accent-bg);color:var(--accent-ink);border:1px solid var(--line-2)}
.ptag.study{background:var(--surface-2);color:var(--muted);border:1px solid var(--line)}
.mapwrap{margin-top:1.5rem}
.geo{display:block;width:100%;height:auto;max-width:52rem;margin:0 auto;border-radius:14px;border:1px solid var(--line);background:var(--surface)}
.map-note{max-width:44rem;margin:1rem auto 0;text-align:center;font-size:.875rem;color:var(--muted);line-height:1.55}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;max-width:52rem;margin:1.5rem auto 0}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:.9rem 1rem;text-align:center}
.stat b{display:block;font-size:1.5rem;font-weight:600;line-height:1;letter-spacing:-.02em;color:var(--ink)}
.stat span{display:block;font-family:var(--mono);font-size:.6875rem;letter-spacing:.02em;color:var(--faint);margin-top:.35rem}
.chips{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;max-width:52rem;margin:1rem auto 0}
.chip{display:inline-flex;align-items:center;gap:.45rem;font-family:var(--mono);font-size:.6875rem;letter-spacing:.02em;color:var(--muted);background:var(--accent-bg);border:1px solid #D9DEF7;border-radius:99px;padding:.32rem .7rem}
.chip i{font-style:normal;font-weight:600;color:var(--accent-ink)}
@media(max-width:640px){.stats{grid-template-columns:1fr 1fr}}
.city h3{font-size:1.02rem}
.city .geo{font-family:var(--mono);font-size:.6875rem;color:var(--faint);white-space:nowrap}
.city .uni{margin:.45rem 0 0;font-size:.9375rem;font-weight:500;color:var(--accent)}
.city p{margin:.35rem 0 0;font-size:.9062rem;color:var(--muted);line-height:1.55}
.city .via{display:inline-block;margin-top:.75rem;font-family:var(--mono);font-size:.6875rem;color:var(--muted);
  border:1px solid var(--line);border-radius:99px;padding:.18rem .55rem}
@media(max-width:760px){.abroad{grid-template-columns:1fr}}

/* marquee */
.mq{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.mq-track{display:flex;gap:.6rem;width:max-content;animation:slide 46s linear infinite}
.mq:hover .mq-track{animation-play-state:paused}
.mq.rev .mq-track{animation-duration:38s;animation-direction:reverse}
@keyframes slide{to{transform:translateX(-50%)}}
.chip{display:flex;align-items:baseline;gap:.55rem;background:var(--surface);border:1px solid var(--line);
  border-radius:99px;padding:.6rem 1.1rem;white-space:nowrap;font-size:.9375rem;font-weight:500;box-shadow:0 1px 2px rgba(16,8,6,.45)}
.chip em{font-style:normal;font-size:.8125rem;color:var(--muted);font-weight:400}
.chip .tag{font-family:var(--mono);font-size:.6875rem;color:var(--accent);background:var(--accent-bg);
  border-radius:99px;padding:.1rem .45rem}

/* career track */
.track{margin-top:.5rem}
.steps{display:grid;grid-template-columns:repeat(6,1fr);gap:.75rem}
.step{position:relative;display:grid;gap:.55rem;align-content:start}
.syr{font-family:var(--mono);font-size:.75rem;color:var(--faint);text-align:left;letter-spacing:.02em}
.scard{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1rem;
  min-height:12.5rem;display:grid;align-content:start;gap:.15rem;
  transition:transform .18s cubic-bezier(.2,.7,.3,1),box-shadow .18s,border-color .18s}
.step:hover .scard{transform:translateY(-3px);border-color:var(--line-2);box-shadow:0 12px 26px -14px rgba(16,8,6,.6)}
.crest{width:38px;height:38px;border-radius:9px;display:grid;place-items:center;margin-bottom:.7rem;
  font-family:var(--mono);font-weight:500;font-size:.72rem;letter-spacing:-.02em}
.crest.cb{background:var(--accent);color:#4A1526}
.crest.logo{padding:0;overflow:hidden;border-radius:9px;background-image:url("data:image/png;base64,");background-size:cover;background-position:center}
.scard .org{font-size:.6875rem;font-weight:600;color:var(--accent-ink);line-height:1.3}
.scard h3{font-size:.9375rem;line-height:1.25;margin:.15rem 0 .1rem;letter-spacing:-.015em}
.scard p{margin:0;font-size:.8125rem;color:var(--muted);line-height:1.5}
.scard .who{font-family:var(--mono);font-size:.625rem;color:var(--faint);margin-top:.55rem;
  padding-top:.5rem;border-top:1px solid var(--line);letter-spacing:.02em}
.step:not(:last-child)::after{content:"";position:absolute;top:.35rem;right:-.53rem;width:.3rem;height:.3rem;
  border-top:1.5px solid var(--line-2);border-right:1.5px solid var(--line-2);transform:rotate(45deg);z-index:1}
.band{display:grid;grid-template-columns:repeat(6,1fr);gap:.75rem;margin-top:.75rem}
.seg{border-radius:8px;padding:.5rem 1rem;font-size:.75rem;font-weight:600;text-align:center;letter-spacing:.01em}
.seg.risk{grid-column:span 3;background:var(--surface-2);color:var(--muted);border:1px solid var(--line)}
.seg.prod{grid-column:span 3;background:var(--accent);color:#4A1526;border:1px solid var(--accent)}

/* prior chapters */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}
.pcard{display:grid;grid-template-columns:3.1rem minmax(0,1fr);gap:.95rem;align-items:center;
  background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:.85rem .95rem;
  box-shadow:0 1px 2px rgba(16,8,6,.45);transition:transform .18s cubic-bezier(.2,.7,.3,1),border-color .18s,box-shadow .18s}
.pcard:hover{transform:translateY(-3px);border-color:var(--accent-bg);box-shadow:0 1px 2px rgba(16,8,6,.45),0 14px 26px -14px rgba(16,8,6,.62)}
.pmark{width:3.1rem;height:3.1rem;border-radius:10px;display:grid;place-items:center;
  font-family:var(--mono);font-weight:500;font-size:.75rem;letter-spacing:-.03em;flex:none;
  background:var(--accent-bg);color:var(--accent-ink);border:1px solid var(--line-2)}
.pmark.bank{background:var(--surface-2);color:var(--ink);border-color:var(--line)}
.pmark.logo{background:transparent;padding:0;overflow:visible;border:0;border-radius:50%}
.pmark.logo img{width:100%;height:100%;object-fit:cover;display:block;border-radius:50%}
.pcard b{display:block;font-size:.875rem;font-weight:600;line-height:1.25}
.pcard span{display:block;font-size:.75rem;color:var(--muted);margin-top:.12rem}
.pcard em{display:block;font-style:normal;font-family:var(--mono);font-size:.6875rem;color:var(--faint);margin-top:.2rem}
@media(max-width:900px){.pgrid{grid-template-columns:1fr 1fr}}
@media(max-width:820px){
  .steps{grid-template-columns:1fr;gap:.55rem}
  .step{grid-template-columns:3.5rem minmax(0,1fr);gap:.9rem;align-items:start}
  .syr{padding-top:.15rem}
  .scard{min-height:0}
  .crest{margin-bottom:.55rem}
  .step:not(:last-child)::after{display:none}
  .band{grid-template-columns:1fr 1fr}.seg.risk,.seg.prod{grid-column:span 1}
}
@media(max-width:560px){.pgrid{grid-template-columns:1fr}}

/* timeline */
.tl{border-top:1px solid var(--line)}
.row{display:grid;grid-template-columns:7rem minmax(0,1fr);gap:1.5rem;padding:1rem .85rem;margin:0 -.85rem;
  border-bottom:1px solid var(--line);align-items:baseline;border-radius:10px;transition:background .15s}
