<script>
(function(){
  var more=document.querySelector('.more');
  more.addEventListener('click',function(){
    var o=more.getAttribute('aria-expanded')==='true';
    more.setAttribute('aria-expanded',String(!o));
    more.lastChild.textContent=o?' Read more about me':' Read less';
  });

  var slides=[].slice.call(document.querySelectorAll('.slide')),
      tabs=[].slice.call(document.querySelectorAll('.tab')),
      dots=document.getElementById('dots'),
      group='exchanges', idx=0;

  function inGroup(){ return slides.filter(function(s){return s.dataset.g===group;}); }
  function render(){
    var g=inGroup();
    slides.forEach(function(s){s.classList.remove('on');});
    g[idx].classList.add('on');
    dots.innerHTML='';
    g.forEach(function(_,i){
      var d=document.createElement('button');
      d.className='dot'+(i===idx?' on':'');
      d.setAttribute('aria-label','Slide '+(i+1));
      d.addEventListener('click',function(){idx=i;render();});
      dots.appendChild(d);
    });
  }
  tabs.forEach(function(t){
    t.addEventListener('click',function(){
      tabs.forEach(function(x){x.setAttribute('aria-selected','false');});
      t.setAttribute('aria-selected','true');
      group=t.dataset.g; idx=0; render();
    });
  });
  document.getElementById('prev').addEventListener('click',function(){
    var n=inGroup().length; idx=(idx-1+n)%n; render();
  });
  document.getElementById('next').addEventListener('click',function(){
    var n=inGroup().length; idx=(idx+1)%n; render();
  });
  render();
})();

(function(){
  var strip=document.getElementById('impactStrip');
  if(!strip) return;
  var slides=[].slice.call(strip.querySelectorAll('.impact-slide'));
  var bar=document.getElementById('impactBar');
  var dotsWrap=document.getElementById('impactDots');
  var i=0, timer=null, DUR=4200;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  slides.forEach(function(_,n){
    var d=document.createElement('button');
    d.className='idot'+(n===0?' on':'');
    d.setAttribute('aria-label','Highlight '+(n+1));
    d.addEventListener('click',function(){go(n);restart();});
    dotsWrap.appendChild(d);
  });
  var dots=[].slice.call(dotsWrap.children);

  function go(n){
    slides[i].classList.remove('on'); dots[i].classList.remove('on');
    i=n; slides[i].classList.add('on'); dots[i].classList.add('on');
    if(bar){ bar.style.transition='none'; bar.style.width='0';
      requestAnimationFrame(function(){ if(!reduce){ bar.style.transition='width '+DUR+'ms linear'; bar.style.width='100%'; } }); }
  }
  function next(){ go((i+1)%slides.length); }
  function start(){ if(reduce) return; timer=setInterval(next,DUR);
    if(bar){ bar.style.transition='width '+DUR+'ms linear'; bar.style.width='100%'; } }
  function stop(){ clearInterval(timer); }
  function restart(){ stop(); start(); }

  strip.addEventListener('mouseenter',function(){ stop(); if(bar){ var w=getComputedStyle(bar).width; bar.style.transition='none'; bar.style.width=w; } });
  strip.addEventListener('mouseleave',restart);
  start();
})();
</script>
